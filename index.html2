}

.featurebox{
  grid-template-columns:1fr;
}

.gallery{
  grid-template-columns:1fr 1fr;
}

.gallery .big{
  grid-row:span 1;
}

.details{
  grid-template-columns:1fr;
}

}

@media(max-width:600px){

.nav{
  padding:14px 17px;
}

.logo{
  font-size:18px;
}

.hero{
  padding:120px 20px 70px;
