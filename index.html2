}

footer p{
  font-size:14px;
  line-height:1.8;
}

footer a{
  color:#dce7f2;
}

.copyright{
  text-align:center;
  border-top:1px solid rgba(255,255,255,.1);
  margin-top:30px;
  padding-top:20px;
  font-size:12px;
}

.floatwa{
  position:fixed;
  right:18px;
  bottom:18px;
  width:58px;
  height:58px;
  border-radius:50%;
  background:#18ad60;
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:25px;
  z-index:999;
  box-shadow:0 8px 25px rgba(0,0,0,.25);
}

@media(max-width:900px){

.navlinks{
