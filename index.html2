}

.contact h2{
  font-size:43px;
  margin-bottom:10px;
}

.contact p{
  color:#dbe7f3;
  margin-bottom:25px;
}

.details{
  max-width:1000px;
  margin:0 auto 40px;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
}

.detail{
  background:white;
  padding:23px;
  border-radius:15px;
  text-align:center;
  box-shadow:0 8px 25px rgba(0,0,0,.07);
}

.detail b{
  display:block;
  color:#071a31;
  margin-bottom:7px;
}

.detail span{
  color:#718096;
  font-size:14px;
}

footer{
  background:#041326;
  color:#aebdcb;
  padding:50px 6% 25px;
}

.footergrid{
  max-width:1150px;
  margin:auto;
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  gap:35px;
}

footer h3{
  color:white;
