  font-size:47px;
}

.hero p{
  font-size:15px;
}

.section{
  padding:70px 18px;
}

.heading h2{
  font-size:35px;
}

.services{
  grid-template-columns:1fr;
}

.cardimg{
  height:260px;
}

.featurebox{
  gap:30px;
}

.featureimg{
  height:350px;
}

.featuretext h2{
  font-size:36px;
}

.gallery{
  grid-template-columns:1fr;
  grid-auto-rows:240px;
}

.contact{
  margin:0 18px 55px;
}

.contact h2{
  font-size:35px;
}

.footergrid{
  grid-template-columns:1fr;
}

}
</style>
</head>

