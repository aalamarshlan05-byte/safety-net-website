<script>

let currentRating=0;

function setRating(number){

currentRating=number;

const stars=document.querySelectorAll("#stars span");

stars.forEach((star,index)=>{

star.innerHTML=index<number?"★":"☆";

});

}


function submitReview(){

const name=
document.getElementById("customerName").value.trim();

const review=
document.getElementById("customerReview").value.trim();

const photo=
document.getElementById("customerPhoto").files[0];

if(!name){

alert("कृपया अपना नाम लिखें।");
return;

}

if(currentRating===0){

alert("कृपया Star Rating दें।");
return;

}

if(!review){

alert("कृपया अपना Review लिखें।");
return;

}


/*
यह GitHub Pages demo storage है।
यह review उसी browser/device में save होगा।
Online central database के लिए backend चाहिए।
*/

const reviews=
JSON.parse(localStorage.getItem("mmReviews")||"[]");


reviews.push({

name:name,

rating:currentRating,

review:review,

photo:photo ? photo.name : "",

date:new Date().toLocaleDateString(),

status:"pending"

});


localStorage.setItem(
"mmReviews",
JSON.stringify(reviews)
);


document.getElementById("reviewMessage").innerText=
"✅ आपका Review successfully submit हो गया। धन्यवाद!";


document.getElementById("customerName").value="";
document.getElementById("customerReview").value="";
document.getElementById("customerPhoto").value="";

currentRating=0;

document.querySelectorAll("#stars span")
.forEach(star=>star.innerHTML="☆");

}

</script>


