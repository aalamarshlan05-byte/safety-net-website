<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

html{
  scroll-behavior:smooth;
}

body{
  font-family:Arial,Helvetica,sans-serif;
  color:#172b43;
  background:
    radial-gradient(circle at 10% 10%,#dff7ff 0,transparent 28%),
    radial-gradient(circle at 90% 20%,#eee2ff 0,transparent 30%),
    radial-gradient(circle at 50% 90%,#fff0d2 0,transparent 30%),
    #f5f8fc;
}

a{
  text-decoration:none;
}

.nav{
  position:fixed;
  top:0;
  left:0;
  right:0;
  z-index:999;
  padding:15px 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:rgba(4,22,43,.93);
  backdrop-filter:blur(15px);
}

.logo{
  color:white;
  font-size:23px;
  font-weight:900;
}

.logo span{
  color:#ffd166;
}

.navlinks{
  display:flex;
  gap:25px;
}

.navlinks a{
  color:white;
  font-size:14px;
  font-weight:700;
}

.navlinks a:hover{
  color:#ffd166;
}

.navbtn{
  background:linear-gradient(135deg,#ffd166,#ff9f1c);
  color:#071a2d;
  padding:11px 17px;
  border-radius:30px;
  font-weight:900;
  font-size:13px;
}

.hero{
  min-height:100vh;
  padding:140px 7% 90px;
  display:flex;
  align-items:center;
  position:relative;
  overflow:hidden;
  background:
    linear-gradient(90deg,rgba(3,17,34,.97),rgba(3,27,55,.72),rgba(3,27,55,.20)),
    url("images/hero.jpg") center/cover no-repeat;
}

.hero:after{
  content:"";
  position:absolute;
  width:450px;
  height:450px;
  right:-150px;
  top:15%;
  border-radius:50%;
  background:linear-gradient(135deg,#00c6ff,#7b2cff,#ff3cac);
  filter:blur(100px);
  opacity:.3;
}

.hero-content{
  max-width:760px;
  position:relative;
  z-index:2;
  color:white;
}

.pill{
  display:inline-block;
  padding:9px 17px;
  border:1px solid rgba(255,255,255,.3);
  border-radius:30px;
  color:#ffd166;
  background:rgba(255,255,255,.08);
  font-size:12px;
  font-weight:800;
  letter-spacing:1.5px;
  margin-bottom:22px;
}

.hero h1{
  font-size:clamp(45px,7vw,80px);
  line-height:1;
  margin-bottom:22px;
}

.hero h1 span{
  background:linear-gradient(90deg,#ffd166,#ff8a00,#ff3cac);
  -webkit-background-clip:text;
  color:transparent;
}

.hero p{
  color:#dce8f5;
  font-size:18px;
  line-height:1.8;
  margin-bottom:30px;
}

.buttons{
  display:flex;
  flex-wrap:wrap;
  gap:12px;
}

.btn{
  padding:15px 23px;
  border-radius:9px;
  font-weight:900;
  display:inline-block;
}

.gold{
  background:linear-gradient(135deg,#ffd166,#ff9f1c);
  color:#071a2d;
}

.green{
  background:#16a85b;
  color:white;
}

.dark{
  background:#071a2d;
  color:white;
}

.stats{
  max-width:1100px;
  margin:-45px auto 0;
  position:relative;
  z-index:5;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  background:white;
  border-radius:20px;
  box-shadow:0 20px 55px rgba(0,0,0,.13);
  overflow:hidden;
}

.stat{
  text-align:center;
  padding:27px 10px;
  border-right:1px solid #e5ebf2;
}

.stat:last-child{
  border:0;
}

.stat strong{
  display:block;
  font-size:27px;
  color:#0876d1;
}

.stat small{
  color:#718096;
}

.section{
  padding:95px 6%;
}

.heading{
  max-width:750px;
  text-align:center;
  margin:0 auto 45px;
}

.heading small{
  color:#0876d1;
  font-weight:900;
  letter-spacing:2px;
}

.heading h2{
  font-size:45px;
  margin:10px 0;
  color:#071a31;
}

.heading p{
  color:#718096;
  line-height:1.7;
}

.services{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:24px;
}

.card{
  background:white;
  border-radius:19px;
  overflow:hidden;
  box-shadow:0 10px 35px rgba(7,30,60,.09);
  transition:.3s;
}

.card:hover{
  transform:translateY(-7px);
  box-shadow:0 20px 50px rgba(7,30,60,.17);
}

.cardimg{
  height:240px;
  position:relative;
  background:#e9eef5;
}

.cardimg img{
  width:100%;
  height:100%;
  object-fit:cover;
  display:block;
}

.tag{
  position:absolute;
  left:13px;
  top:13px;
  background:rgba(5,22,43,.92);
  color:#ffd166;
  padding:7px 11px;
  border-radius:20px;
  font-size:10px;
  font-weight:900;
}

.cardbody{
  padding:20px;
}

.cardbody h3{
  color:#071a31;
  font-size:20px;
  margin-bottom:8px;
}

.cardbody p{
  color:#718096;
  line-height:1.7;
  font-size:14px;
  min-height:70px;
}

.cardactions{
  display:flex;
  gap:8px;
  margin-top:15px;
}

.cardactions a{
  padding:10px 13px;
  border-radius:7px;
  font-size:12px;
  font-weight:900;
  color:white;
}

.feature{
  background:
    linear-gradient(135deg,#06152b,#07568e,#071a31);
  color:white;
  overflow:hidden;
}

.featurebox{
  max-width:1150px;
  margin:auto;
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:55px;
  align-items:center;
}

.featureimg{
  height:500px;
  border-radius:22px;
  overflow:hidden;
  box-shadow:0 25px 60px rgba(0,0,0,.3);
}

.featureimg img{
  width:100%;
  height:100%;
  object-fit:cover;
}

.featuretext h2{
  font-size:48px;
  margin:12px 0 18px;
}

.featuretext p{
  color:#d0dce8;
  line-height:1.8;
}

.points{
  margin-top:24px;
  display:grid;
  gap:13px;
}

.point b{
  color:#ffd166;
  margin-right:8px;
}

.gallery{
  max-width:1200px;
  margin:auto;
  display:grid;
  grid-template-columns:2fr 1fr 1fr;
  grid-auto-rows:220px;
  gap:14px;
}

.gallery div{
  overflow:hidden;
  border-radius:17px;
}

.gallery .big{
  grid-row:span 2;
}

.gallery img{
  width:100%;
  height:100%;
  object-fit:cover;
  transition:.4s;
}

.gallery img:hover{
  transform:scale(1.06);
}

.reviewarea{
  background:
    radial-gradient(circle at 15% 20%,#dff7ff,transparent 28%),
    radial-gradient(circle at 85% 80%,#eadfff,transparent 30%);
}

.reviewbox{
  max-width:700px;
  margin:auto;
  padding:30px;
  background:white;
  border-radius:20px;
  box-shadow:0 15px 45px rgba(0,0,0,.1);
}

.reviewbox label{
  display:block;
  font-weight:800;
  margin:10px 0 7px;
}

.reviewbox input,
.reviewbox textarea{
  width:100%;
  padding:13px;
  border:1px solid #d8e1eb;
  border-radius:8px;
  font-family:inherit;
}

.stars{
  font-size:34px;
  color:#ffd166;
  margin:5px 0 15px;
  cursor:pointer;
}

.reviewbox button{
  width:100%;
  margin-top:15px;
  padding:14px;
  border:0;
  border-radius:8px;
  background:linear-gradient(135deg,#0876d1,#7b2cff);
  color:white;
  font-weight:900;
  cursor:pointer;
}

#reviewMessage{
  text-align:center;
  margin-top:15px;
  font-weight:bold;
}

.contact{
  margin:0 6% 75px;
  padding:65px 25px;
  text-align:center;
  border-radius:25px;
  color:white;
  background:
    linear-gradient(135deg,rgba(5,25,50,.94),rgba(7,107,181,.85)),
